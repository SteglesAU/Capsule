{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "credentialsSource": "local"
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ALLOW_OVERRIDE": "1"
      }
    },
    "androidprod": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./.eas-creds/AuthKey_768FX6K6T7.p8",
        "ascApiKeyId": "768FX6K6T7",
        "ascApiKeyIssuerId": "56a5aece-9559-4025-aa93-83b3cd30d065",
